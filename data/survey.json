      "id": "communication",
      "title": "İletişim tarzı",
      "subtitle": "Kendini nasıl ifade ediyorsun?",
      "sheet": 2,
      "evaluationSheet": 3,
      "startRow": 16,
      "count": 40,
      "answerColumn": "B",
      "evaluationColumn": "B",
      "kind": "scale",
      "max": 5,
      "instruction": "Her ifadeyi kendi davranışlarını düşünerek 1–5 arasında puanla.",
      "labels": [
        "Hiçbir zaman",
        "Nadiren",
        "Bazen",
        "Çoğunlukla",
        "Her zaman"
      ],
      "sheetName": "İletişim Tarzı Envanteri",
      "evaluationSheetName": "İletişim Tarzı Değerlendirme",
      "questions": [
        {
          "id": "communication-1",
          "number": 1,
          "cell": "B16",
          "evaluationCell": "B2",
          "text": "Yardıma ihtiyacım olduğunda başkalarından yardım istemekten çekinmem."
        },
        {
          "id": "communication-2",
          "number": 2,
          "cell": "B17",
          "evaluationCell": "B3",
          "text": "Öfke, gerginlik gibi bir duygu hissettiğimde anlaşılmaması için duygularımı kendime saklarım"
        },
        {
          "id": "communication-3",
          "number": 3,
          "cell": "B18",
          "evaluationCell": "B4",
          "text": "Söylediklerim başkalarına ağır gelebilir, onların incineceğini bilsem bile net olmaktan yanayım."
        },
        {
          "id": "communication-4",
          "number": 4,
          "cell": "B19",
          "evaluationCell": "B5",
          "text": "Bana bir haksızlık yapılmışsa,o an tepki göstermek yerine kafamda tartıp, düşünüp, tasarlayarak daha sonra bunun karşılığını vermeyi tercih ederim."
        },
        {
          "id": "communication-5",
          "number": 5,
          "cell": "B20",
          "evaluationCell": "B6",
          "text": "İnsanlarla iletişim halindeyken, göz temasını rahatlıkla koruyabilirim."
        },
        {
          "id": "communication-6",
          "number": 6,
          "cell": "B21",
          "evaluationCell": "B7",
          "text": "Başkalarının benimle iligli düşüncelerine bazen gereğinden fazla önem verip, onların beklentilerine göre davranmaya çalışırım."
        },
        {
          "id": "communication-7",
          "number": 7,
          "cell": "B22",
          "evaluationCell": "B8",
          "text": "İstek ve ihtiyaçlarımdan başkalarını rahatsız edecek olsa bile vazgeçmem."
        },
        {
          "id": "communication-8",
          "number": 8,
          "cell": "B23",
          "evaluationCell": "B9",
          "text": "Birşeyden memnun olmadığımda, hiçbir şey söylemem, ancak beden dilim memnuniyetsizliğimi dile getirir."
        },
        {
          "id": "communication-9",
          "number": 9,
          "cell": "B24",
          "evaluationCell": "B10",
          "text": "İnsanlarla aynı görüşü paylaşmadığımda, bunu belirtirim."
        },
        {
          "id": "communication-10",
          "number": 10,
          "cell": "B25",
          "evaluationCell": "B11",
          "text": "İnsanlar sözlerini yerine getirmediğinde, ne kadar kırıldığımı söylemek yerine susmayı tercih ederim."
        },
        {
          "id": "communication-11",
          "number": 11,
          "cell": "B26",
          "evaluationCell": "B12",
          "text": "Eğer gerek duyarsam bazı kişilere karşı kaba ve zorlayıcı davranış göstermekten kaçınmam."
        },
        {
          "id": "communication-12",
          "number": 12,
          "cell": "B27",
          "evaluationCell": "B13",
          "text": "Bazı olaylarda tepkimi net olarak göstermediğim halde o konuyu kafama takıp günlerce üzerine düşündüğüm olur."
        },
        {
          "id": "communication-13",
          "number": 13,
          "cell": "B28",
          "evaluationCell": "B14",
          "text": "Bir kişiye kızdıysam, uygun anda bunu ifade ederim."
        },
        {
          "id": "communication-14",
          "number": 14,
          "cell": "B29",
          "evaluationCell": "B15",
          "text": "Başkalarının beni övmesi beni utandırır."
        },
        {
          "id": "communication-15",
          "number": 15,
          "cell": "B30",
          "evaluationCell": "B16",
          "text": "Önemli olduğunu düşündüğüm bir konuda söyleyeceğim birşey varsa, konuşmayı keserek, araya girmekten çekinmem."
        },
        {
          "id": "communication-16",
          "number": 16,
          "cell": "B31",
          "evaluationCell": "B17",
          "text": "Birisi bana karşı bir hata yaptıysa, bazı durumlarda ona imalı laflar gönderdiğim; onu ima ederek örnekler verdiğim olur."
        },
        {
          "id": "communication-17",
          "number": 17,
          "cell": "B32",
          "evaluationCell": "B18",
          "text": "Kendimi suçlu hissetmeden, insanlara “Hayır” diyebilirim"
        },
        {
          "id": "communication-18",
          "number": 18,
          "cell": "B33",
          "evaluationCell": "B19",
          "text": "Çatışma ve huzursuzluk çıkmaması için taviz vermek uğruna bile olsa uzlaşmacı davranırım."
        },
        {
          "id": "communication-19",
          "number": 19,
          "cell": "B34",
          "evaluationCell": "B20",
          "text": "İş ortamında başkalarının duygularını düşünerek hareket etmem, sonuçta buranın profesyonel bir ortam olduğunu herkesin bilmesini isterim."
        },
        {
          "id": "communication-20",
          "number": 20,
          "cell": "B35",
          "evaluationCell": "B21",
          "text": "İnsanlara karşı direkt olarak aynı fikirde olmadığımı belirtmem ancak, memnuniyetsizliğimi anlamalarını sağlarım."
        },
        {
          "id": "communication-21",
          "number": 21,
          "cell": "B36",
          "evaluationCell": "B22",
          "text": "Kendimi suçlu hissetmeden, kendim için birşey isteyebilir, başkalarına isteklerimi söyleyebilirim."
        },
        {
          "id": "communication-22",
          "number": 22,
          "cell": "B37",
          "evaluationCell": "B23",
          "text": "İnsanlar benden birşey rica ettiğinde, ricalarını kırmamak uğruna bazen kendi planlarımı değiştiririm."
        },
        {
          "id": "communication-23",
          "number": 23,
          "cell": "B38",
          "evaluationCell": "B24",
          "text": "İnsanların yaptığı hataları hemen fark ederim"
        },
        {
          "id": "communication-24",
          "number": 24,
          "cell": "B39",
          "evaluationCell": "B25",
          "text": "İnsanlarla aynı fikirde olmadığımda, onlarla tartışmayıp uzlaşmacı göründüğüm, ama yine de kendi bildiğimi yaptığım durumlar olur."
        },
        {
          "id": "communication-25",
          "number": 25,
          "cell": "B40",
          "evaluationCell": "B26",
          "text": "Duygularımı, dürüstçe, oğrudan ve net olarak ifade edebilirim."
        },
        {
          "id": "communication-26",
          "number": 26,
          "cell": "B41",
          "evaluationCell": "B27",
          "text": "Benim için yeni bir ortama girdiğimde, rahatsız olma eğilimim vardır."
        },
        {
          "id": "communication-27",
          "number": 27,
          "cell": "B42",
          "evaluationCell": "B28",
          "text": "Sözlerime vurgu katmak için, vücut hareketleri, jest ve mimikleri bolca kullanırım."
        },
        {
          "id": "communication-28",
          "number": 28,
          "cell": "B43",
          "evaluationCell": "B29",
          "text": "Fikirlerimi ya da duygularımı doğrudan söylemeyip ima ettiğim zamanlar olur"
        },
        {
          "id": "communication-29",
          "number": 29,
          "cell": "B44",
          "evaluationCell": "B30",
          "text": "Kendime tanıdığım hakları, karşımdaki kişiye de tanırım."
        },
        {
          "id": "communication-30",
          "number": 30,
          "cell": "B45",
          "evaluationCell": "B31",
          "text": "Birilerine olumsuz bir şey söylemem ya da onların eksikliklerini göstermem gerektiğinde suçluluk hissederim."
        },
        {
          "id": "communication-31",
          "number": 31,
          "cell": "B46",
          "evaluationCell": "B32",
          "text": "Her koşulda kontrolün bende olmasını isterim."
        },
        {
          "id": "communication-32",
          "number": 32,
          "cell": "B47",
          "evaluationCell": "B33",
          "text": "Eğer bir kişiyi sevmezsem, bunu dolaylı yollardan anlamasını sağlarım."
        },
        {
          "id": "communication-33",
          "number": 33,
          "cell": "B48",
          "evaluationCell": "B34",
          "text": "Hakkımı korumam gerektiğinde, bunu gerilmeden, bağırmadan yapabilirim"
        },
        {
          "id": "communication-34",
          "number": 34,
          "cell": "B49",
          "evaluationCell": "B35",
          "text": "İletişim kurarken insanların gözlerine bakmak beni zorlar."
        },
        {
          "id": "communication-35",
          "number": 35,
          "cell": "B50",
          "evaluationCell": "B36",
          "text": "Bazı kişiler beni o kadar çileden çıkarır ki şiddetli tepkiler verebilirim."
        },
        {
          "id": "communication-36",
          "number": 36,
          "cell": "B51",
          "evaluationCell": "B37",
          "text": "Bir tartışmada haksız duruma düştüğümde çekip giderim."
        },
        {
          "id": "communication-37",
          "number": 37,
          "cell": "B52",
          "evaluationCell": "B38",
          "text": "Uygun olmayan ya da hoşuma gitmeyen bir davranışa maruz kaldığımda bundan hoşlanmadığımı rahatlıkla ifade edebilirim."
        },
        {
          "id": "communication-38",
          "number": 38,
          "cell": "B53",
          "evaluationCell": "B39",
          "text": "İnsanların duygularını incitebilecek konuları, haklı olsam bile direkt olarak kendilerine söylemekten hoşlanmam."
        },
        {
          "id": "communication-39",
          "number": 39,
          "cell": "B54",
          "evaluationCell": "B40",
          "text": "Yoğun duygular yaşadığımda tepkilerimi kontrol etmekte zorluk yaşarım."
        },
        {
          "id": "communication-40",
          "number": 40,
          "cell": "B55",
          "evaluationCell": "B41",
          "text": "Karşımdaki kişiye hiçbir tepki vermediğim, ama bir sonraki karşılaşmamızda halen o tartışmanın etkisiyle davrandığım durumlar olur."
        }
      ]
    },
